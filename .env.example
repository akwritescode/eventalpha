# Copy to .env and fill in. .env is git-ignored.

# SEC fair-access policy: descriptive User-Agent with a real contact email.
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="eventalpha your-email@example.com"
SEC_REQUESTS_PER_SECOND=4

# Article classifier. CLASSIFIER_PROVIDER picks the adapter in
# src/eventalpha/classification/providers/; CLASSIFIER_MODEL overrides its pinned default model.
CLASSIFIER_PROVIDER=typesafe
CLASSIFIER_MODEL=
# Credentials for the selected provider.
TYPESAFE_API_KEY=

# Host-side tools (alembic, pytest, scripts) talk to warehouse-db via the published port.
EVENTALPHA_DATABASE_URL=postgresql+psycopg://eventalpha:eventalpha@localhost:5433/eventalpha

# Docker: run `echo AIRFLOW_UID=$(id -u)` on Linux. Mac can leave the default.
AIRFLOW_UID=50000
FERNET_KEY=
AIRFLOW_JWT_SECRET=change-me-local-only

# Redis event stream. Compose sets this for containers; host-side scripts use the published port.
REDIS_URL=redis://localhost:6379/0

# ---------- Market and macro data ----------
# Prices and the exchange session calendar. Provider adapters: src/eventalpha/marketdata/providers/.
MARKET_DATA_PROVIDER=tradier
# Tradier brokerage API key (Settings -> API Access in your Tradier account).
TRADIER_BROKER_KEY=
# FRED (St. Louis Fed), free: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
# BLS, optional (works without; a free key raises the daily limit): https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# ---------- Alerts ----------
# Dedicated EventAlpha bot (create with @BotFather). DAG failures and high-impact events go here.
TELEGRAM_BOT_TOKEN=
# Your user or group chat id (message the bot, then GET https://api.telegram.org/bot<token>/getUpdates)
TELEGRAM_CHAT_ID=
# Dead-man's switch: the daily SEC DAGs ping this URL; healthchecks.io alerts if a day is missed.
HEALTHCHECKS_PING_URL=

# ---------- Production only (Lightsail) ----------
# Public hostname for the API (Caddy gets a Let's Encrypt certificate for it).
# Free option until a real domain is bought: a DuckDNS subdomain pointed at the static IP.
API_DOMAIN=eventalpha.duckdns.org
# Token from https://www.duckdns.org (keeps the record pointed at the server's IP).
DUCKDNS_TOKEN=
# Image tag to run; the deploy workflow sets this to the git commit SHA.
IMAGE_TAG=latest
IMAGE_REGISTRY=ghcr.io/akwritescode
# Object storage for raw landing files and nightly pg_dump backups.
# Leave RAW_BUCKET empty locally to keep writing under RAW_DATA_DIR.
RAW_BUCKET=
BACKUP_BUCKET=
BACKUP_RETENTION_DAYS=30
AWS_REGION=us-east-1
# Credentials of a Lightsail bucket access key (or an IAM user scoped to the buckets).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Production passwords (local compose uses the defaults). Generate with: openssl rand -base64 24
WAREHOUSE_DB_PASSWORD=
AIRFLOW_DB_PASSWORD=
# Airflow UI login (user "admin"); the UI is only reachable through an SSH tunnel.
AIRFLOW_ADMIN_PASSWORD=
