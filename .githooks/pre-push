#!/bin/sh
# Shared hook (enable once per clone: git config core.hooksPath .githooks).
# Refuses to push any commit whose message isn't a Conventional Commit, then runs any
# machine-local pre-push hook in .git/hooks with the same input.
z=0000000000000000000000000000000000000000
input=$(cat)
status=0
while read -r lref lsha rref rsha; do
  [ -z "$lsha" ] || [ "$lsha" = "$z" ] && continue
  if [ "$rsha" = "$z" ]; then range="$lsha"; else range="$rsha..$lsha"; fi
  "$(git rev-parse --show-toplevel)/scripts/check-commit-msg.sh" --range "$range" || status=1
done <<EOT
$input
EOT
[ $status -eq 0 ] || { echo "Push blocked: reword the commits above (git rebase -i) and push again." >&2; exit 1; }
local_hook="$(git rev-parse --git-dir)/hooks/pre-push"
[ -x "$local_hook" ] && { printf '%s\n' "$input" | "$local_hook" "$@"; exit $?; }
exit 0
