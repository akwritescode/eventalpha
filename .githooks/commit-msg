#!/bin/sh
# Shared hook (enable once per clone: git config core.hooksPath .githooks).
"$(git rev-parse --show-toplevel)/scripts/check-commit-msg.sh" "$1" || exit 1
# Then any machine-local hook of the same name in .git/hooks.
local_hook="$(git rev-parse --git-dir)/hooks/commit-msg"
[ -x "$local_hook" ] && exec "$local_hook" "$@"
exit 0
