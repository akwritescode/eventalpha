# Refuse to install with a Node/npm outside package.json "engines" (Node 22, npm 10): the
# versions CI and Vercel use. A newer npm rewrites package-lock.json in ways npm 10's `npm ci`
# rejects (e.g. pruning optional peer entries), which breaks the Vercel build.
# Locally: `nvm use` in web/ (reads .nvmrc).
engine-strict=true
